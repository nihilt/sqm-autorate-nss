#!/bin/sh /etc/rc.common
# sqm-autorate: procd service for the latency-aware controller of the NSS shaper.
#
# The configuration the daemon reads is rendered into memory (/var/sqm-autorate.conf) from the active profile,
# so starting, reloading and switching profiles never write flash. See /usr/lib/sqm-autorate/common.sh.

START=99
STOP=10
USE_PROCD=1

SQMAR_LIB=${SQMAR_LIB:-/usr/lib/sqm-autorate}
# shellcheck disable=SC1091
. "$SQMAR_LIB/common.sh" || exit 1

service_triggers() {
    # a changed /etc/config/sqm (new rates) makes the daemon read its configuration again
    procd_add_reload_trigger sqm
}

start_service() {
    sqmar_cleanup_legacy
    sqmar_render || echo "sqm-autorate: could not render $SQMAR_CONF, the daemon will use built-in defaults"

    # No waiting for SQM or for the network: the daemon copes with a missing shaper (it waits quietly and
    # picks it up when nss-rk.qos creates it) and with probe blackouts, and nss-rk.qos asks it to reload after
    # every SQM start.
    procd_open_instance
    procd_set_param command "$SQMAR_SCRIPT"
    procd_set_param respawn
    procd_set_param stderr 1
    procd_set_param env CONFIG="$SQMAR_CONF" PIDFILE="$SQMAR_PIDFILE" LOGFILE="$SQMAR_LOGFILE"
    procd_close_instance
}

# "reload" (also what nss-rk.qos and the sqm config trigger call): render again, then SIGHUP
reload_service() {
    sqmar_render || return 1
    if sqmar_hup; then
        echo "sqm-autorate: asked the daemon to reload"
    else
        echo "sqm-autorate: not running; the profile is used when it starts"
    fi
    return 0
}
