#!/bin/sh
# sqm-status: look at sqm-autorate and change its settings.
#
# Changes are made in memory (they apply at once and are gone at reboot). Flash is written only by
#   save, unsave, rotate-on, rotate-off   (and 'switch-profile NAME --default').

SQMAR_LIB=${SQMAR_LIB:-/usr/lib/sqm-autorate}
# shellcheck disable=SC1091
. "$SQMAR_LIB/common.sh" || exit 1

usage() {
    cat <<EOT
Usage: sqm-status [COMMAND]

Look
  (none)                  short overview: state, profile, shaper rates, checks, last log lines
  full                    everything, with the last 20 log lines
  current                 name of the active profile
  rates                   the rate the shaper has now, next to the base rate
  check [NAME]            compare a profile with what the daemon reads (default: the active one)
  get KEY                 the value the daemon is using for KEY, and where it comes from
  keys                    the keys that 'set' accepts, with their ranges
  log-live                follow the log (Ctrl+C stops)

Change, in memory (applied now, gone at reboot)
  set KEY VALUE           change one setting
  unset KEY               drop one runtime setting
  reset                   drop all runtime settings
  reload                  render the configuration again and tell the daemon
  log-on, log-off
  log-level-0|1|2         0 errors only, 1 normal, 2 with per-cycle details
  log-mode-0|1|2          0 silent, 1 on rate changes, 2 every cycle
  log-format-compact|verbose|json
  reflector-count N       reflector-rotation-random|roundrobin
  probe-min MS            probe-setuid-on|off        alpha-ewma V
  log-clear               empty the log (memory)
  log-disable-all, log-enable-all    same as log-off, log-on

Keep across reboot (writes flash, only when you ask)
  save                    keep the runtime settings for the active profile
  unsave                  forget the settings saved for the active profile
  rotate-on, rotate-off   switch the log rotation file on or off

Profiles: switch-profile --help
EOT
}

# ------------------------------------------------------------------ helpers

val() { sqmar_ensure_conf; sqmar_conf_get "$SQMAR_CONF" "$1" 2>/dev/null || echo "not set"; }

# do_set KEY VALUE: validate, write to the runtime file (memory), apply
do_set() {
    local msg
    if ! msg=$(sqmar_validate "$1" "$2"); then
        sqmar_err "$msg"
        exit 2
    fi
    sqmar_ovr_put "$(sqmar_runtime_file)" "$1" "$2" || { sqmar_err "could not write the runtime settings"; exit 1; }
    echo "$1=$2   (memory only; 'sqm-status save' keeps it across a reboot)"
    sqmar_apply
}

need_arg() {
    [ -n "${2:-}" ] || { sqmar_err "$1 needs a value (sqm-status --help)"; exit 2; }
}

human_size() {
    awk -v b="$1" 'BEGIN { if (b < 1024) printf "%d B", b; else if (b < 1048576) printf "%.1f KB", b / 1024; else printf "%.1f MB", b / 1048576 }'
}

rotation_state() {
    if [ -f "$SQMAR_LOGROTATE" ]; then echo on; else echo off; fi
}

show_rates() {
    local up dn r kb base
    up=$(val upload_interface); [ "$up" = "not set" ] && up=eth0
    dn=nssifb
    for d in up dn; do
        if [ "$d" = up ]; then dev=$up; key=upload_base_kbits; else dev=$dn; key=download_base_kbits; fi
        r=$(sqmar_shaper_rate "$dev")
        base=$(val "$key")
        if [ -z "$r" ]; then
            printf '  %-8s no NSS shaper found\n' "$dev"
            continue
        fi
        kb=$(sqmar_to_kbit "$r")
        if [ -n "$kb" ] && [ "$base" != "not set" ] && [ "$base" != auto ] && [ "$base" -gt 0 ] 2>/dev/null; then
            printf '  %-8s %s  = %s kbit/s, %s%% of base %s\n' "$dev" "$r" "$kb" "$(awk -v a="$kb" -v b="$base" 'BEGIN { printf "%d", a * 100 / b + 0.5 }')" "$base"
        else
            printf '  %-8s %s  (base %s)\n' "$dev" "$r" "$base"
        fi
    done
}

show_state() {
    local pid up act def rt sv n=0 size
    pid=$(sqmar_daemon_pid) && up=$(sqmar_uptime_s "$pid")
    if [ -n "$pid" ]; then
        if [ -n "$up" ]; then
            printf 'daemon      running, PID %s, up %02d:%02d:%02d\n' "$pid" $((up / 3600)) $((up % 3600 / 60)) $((up % 60))
        else
            printf 'daemon      running, PID %s\n' "$pid"
        fi
    else
        echo "daemon      NOT running   (/etc/init.d/sqm-autorate start)"
    fi
    act=$(sqmar_active_name); def=$(sqmar_boot_name)
    printf 'profile     %s%s\n' "${act:-none}" "$( [ "$act" = "$def" ] || printf '   (boot profile: %s)' "$def" )"
    rt=$(sqmar_runtime_file); sv=$(sqmar_saved_file "$act")
    printf 'settings    %s runtime (memory), %s saved for this profile (flash)\n' "$(sqmar_ovr_count "$rt")" "$(sqmar_ovr_count "$sv")"
    [ -s "$rt" ] && printf '            runtime: %s\n' "$(tr '\n' ' ' < "$rt")"
    echo "shaper"
    show_rates
    printf 'log         enabled=%s level=%s mode=%s format=%s' "$(val log_enabled)" "$(val log_level)" "$(val log_mode)" "$(val log_format)"
    if [ -f "$SQMAR_LOGFILE" ]; then size=$(wc -c < "$SQMAR_LOGFILE"); printf ', %s' "$(human_size "$size")"; fi
    printf ', rotation %s\n' "$(rotation_state)"
    printf 'probing     reflectors=%s (%s), probe_min=%s ms, alpha_ewma=%s, setuid_fix=%s\n' \
        "$(val reflector_count)" "$(val reflector_rotation)" "$(val probe_min_ms)" "$(val alpha_ewma)" "$(val probe_setuid_fix)"
    if [ -n "$act" ]; then
        n=$(sqmar_check "$act" | grep -c '^warn\|^FAIL')
        if [ "$n" -eq 0 ]; then echo "checks      ok"; else echo "checks      $n finding(s), see: sqm-status check"; fi
    fi
    [ -f "${SQMAR_LOGROTATE}.disabled" ] && echo "note        ${SQMAR_LOGROTATE}.disabled is a leftover of an older version; logrotate still reads it: rm it, or sqm-status rotate-off"
    return 0
}

show_log() {
    echo
    echo "last $1 log lines"
    if [ -f "$SQMAR_LOGFILE" ] && [ -s "$SQMAR_LOGFILE" ]; then tail -n "$1" "$SQMAR_LOGFILE"; else echo "(no log)"; fi
}

show_full() {
    show_state
    echo
    echo "all runtime and saved settings"
    local act; act=$(sqmar_active_name)
    for f in "$(sqmar_saved_file "$act")" "$(sqmar_runtime_file)"; do
        [ -s "$f" ] && { echo "  ${f##*/}:"; sed 's/^/    /' "$f"; }
    done
    echo
    sqmar_check "$act"
    sqmar_setuid_note
    show_log 20
}

do_save() {
    local act rt sv new line
    act=$(sqmar_active_name); rt=$(sqmar_runtime_file)
    [ -n "$act" ] || { sqmar_err "no active profile"; exit 1; }
    [ -s "$rt" ] || { echo "no runtime settings to save"; exit 0; }
    sv=$(sqmar_saved_file "$act"); new="$SQMAR_RUN_DIR/saved.new"
    if [ -f "$sv" ]; then cp "$sv" "$new"; else : > "$new"; fi
    while IFS= read -r line; do
        [ -n "$line" ] && sqmar_ovr_put "$new" "${line%%=*}" "${line#*=}"
    done < "$rt"
    if [ -f "$sv" ] && [ "$(cat "$new")" = "$(cat "$sv")" ]; then
        echo "already saved (flash not written)"
    elif cp "$new" "$sv.tmp" && mv -f "$sv.tmp" "$sv"; then
        echo "saved for profile '$act' in $sv (flash written):"
        sed 's/^/  /' "$sv"
    else
        rm -f "$sv.tmp" "$new"; sqmar_err "could not write $sv"; exit 1
    fi
    rm -f "$new" "$rt"
    sqmar_apply
}

do_unsave() {
    local act sv
    act=$(sqmar_active_name); sv=$(sqmar_saved_file "$act")
    if [ -f "$sv" ]; then
        rm -f "$sv" && echo "removed $sv (flash written)"
    else
        echo "nothing saved for profile '$act'"
    fi
    sqmar_apply
}

do_get() {
    local k=$1 v act
    case "$k" in *[!a-z0-9_]*|'') sqmar_err "not a key name: $k"; exit 2 ;; esac
    act=$(sqmar_active_name)
    sqmar_ensure_conf
    if ! v=$(sqmar_conf_get "$SQMAR_CONF" "$k"); then echo "$k is not set (the daemon uses its built-in default)"; exit 1; fi
    if sqmar_conf_get "$(sqmar_runtime_file)" "$k" >/dev/null 2>&1; then src="runtime setting, memory"
    elif sqmar_conf_get "$(sqmar_saved_file "$act")" "$k" >/dev/null 2>&1; then src="saved setting, flash"
    else src="profile $act"; fi
    echo "$k=$v   ($src)"
}

# ------------------------------------------------------------------ commands

cmd=${1:-status}
case "$cmd" in
    status)             show_state; show_log 5 ;;
    full)               show_full ;;
    current)            n=$(sqmar_active_name); echo "Active profile: ${n:-none}" ;;
    rates)              show_rates ;;
    reload)             sqmar_apply ;;
    check)
        n=${2:-$(sqmar_active_name)}
        sqmar_check "$n"; rc=$?
        sqmar_setuid_note
        exit "$rc" ;;
    get)                need_arg get "${2:-}"; do_get "$2" ;;
    keys)
        for k in $(sqmar_settable_keys); do
            set -- $(sqmar_key_spec "$k")
            case "$1" in enum) shift; r="one of: $*" ;; intauto) r="$2 to $3, or auto" ;; *) r="$2 to $3" ;; esac
            printf '  %-32s %s\n' "$k" "$r"
        done ;;
    set)                need_arg set "${2:-}"; [ $# -ge 3 ] || { sqmar_err "set needs KEY and VALUE"; exit 2; }; do_set "$2" "$3" ;;
    unset)
        need_arg unset "${2:-}"
        case "$2" in *[!a-z0-9_]*) sqmar_err "not a key name: $2"; exit 2 ;; esac
        if sqmar_conf_get "$(sqmar_runtime_file)" "$2" >/dev/null 2>&1; then
            sqmar_ovr_del "$(sqmar_runtime_file)" "$2" && echo "runtime setting $2 dropped"
            sqmar_apply
        else
            echo "no runtime setting for $2"
        fi ;;
    reset)
        rt=$(sqmar_runtime_file)
        if [ -s "$rt" ]; then echo "dropping: $(tr '\n' ' ' < "$rt")"; rm -f "$rt"; else echo "no runtime settings"; fi
        sqmar_apply ;;
    save)               do_save ;;
    unsave)             do_unsave ;;
    log-on|log-enable-all)   do_set log_enabled 1 ;;
    log-off|log-disable-all) do_set log_enabled 0 ;;
    log-level-0)        do_set log_level 0 ;;
    log-level-1)        do_set log_level 1 ;;
    log-level-2)        do_set log_level 2 ;;
    log-level-3)        sqmar_err "level 3 does not exist: the daemon has levels 0, 1 and 2 (log-level-2 is the most detailed)"; exit 2 ;;
    log-format-compact) do_set log_format compact ;;
    log-format-verbose) do_set log_format verbose ;;
    log-format-json)    do_set log_format json ;;
    log-mode-0)         do_set log_mode 0 ;;
    log-mode-1)         do_set log_mode 1 ;;
    log-mode-2)         do_set log_mode 2 ;;
    reflector-count)    need_arg reflector-count "${2:-}"; do_set reflector_count "$2" ;;
    reflector-rotation-random)     do_set reflector_rotation random ;;
    reflector-rotation-roundrobin) do_set reflector_rotation roundrobin ;;
    probe-min)          need_arg probe-min "${2:-}"; do_set probe_min_ms "$2" ;;
    probe-setuid-on)    do_set probe_setuid_fix 1 ;;
    probe-setuid-off)   do_set probe_setuid_fix 0 ;;
    alpha-ewma)         need_arg alpha-ewma "${2:-}"; do_set alpha_ewma "$2" ;;
    log-live)
        if [ -f "$SQMAR_LOGFILE" ]; then echo "=== live log (Ctrl+C stops) ==="; exec tail -f "$SQMAR_LOGFILE"; else echo "no log file at $SQMAR_LOGFILE"; fi ;;
    log-clear)
        if [ -f "$SQMAR_LOGFILE" ]; then : > "$SQMAR_LOGFILE"; echo "log emptied"; else echo "no log file at $SQMAR_LOGFILE"; fi ;;
    rotate-on)
        if [ -f "$SQMAR_LOGROTATE" ]; then
            echo "log rotation is already on"
        elif [ -r "$SQMAR_LOGROTATE_TPL" ] && cp "$SQMAR_LOGROTATE_TPL" "$SQMAR_LOGROTATE"; then
            rm -f "${SQMAR_LOGROTATE}.disabled"
            echo "log rotation on ($SQMAR_LOGROTATE written; flash)"
        else
            sqmar_err "cannot create $SQMAR_LOGROTATE from $SQMAR_LOGROTATE_TPL"; exit 1
        fi ;;
    rotate-off)
        if [ -f "$SQMAR_LOGROTATE" ] || [ -f "${SQMAR_LOGROTATE}.disabled" ]; then
            rm -f "$SQMAR_LOGROTATE" "${SQMAR_LOGROTATE}.disabled"
            echo "log rotation off ($SQMAR_LOGROTATE removed; flash). The daemon still empties its log at 5 MB."
        else
            echo "log rotation is already off"
        fi ;;
    -h|--help|help)     usage ;;
    *)                  sqmar_err "unknown command '$cmd'"; usage >&2; exit 2 ;;
esac
