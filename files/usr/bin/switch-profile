#!/bin/sh
# switch-profile: choose the sqm-autorate profile.
#
# The switch lives in memory and is gone at reboot. Flash is written only with --default.

SQMAR_LIB=${SQMAR_LIB:-/usr/lib/sqm-autorate}
# shellcheck disable=SC1091
. "$SQMAR_LIB/common.sh" || exit 1

usage() {
    cat <<EOF
Usage: switch-profile                       show the active profile and the available ones
       switch-profile list                  list the profiles
       switch-profile current               print the active profile name
       switch-profile NAME                  use profile NAME now (memory only, back to the boot profile at reboot)
       switch-profile NAME --default        ... and also use it at every boot (writes $SQMAR_DEFAULT_FILE)

Profiles are the files $SQMAR_PROFILE_DIR/sqm-autorate-NAME.conf.
A switch drops the runtime settings made with 'sqm-status set' (settings saved with 'sqm-status save' stay).
EOF
}

show_state() {
    local act def n mark
    act=$(sqmar_active_name)
    def=$(sqmar_boot_name)
    echo "active profile: ${act:-none}"
    echo "boot profile:   ${def:-none}"
    echo "available:"
    for n in $(sqmar_list_profiles); do
        mark=
        [ "$n" = "$act" ] && mark=" (active)"
        [ "$n" = "$def" ] && mark="$mark (boot)"
        echo "  - $n$mark"
    done
}

# --- arguments
case "${1:-}" in
    '')                   show_state; exit 0 ;;
    -h|--help|help)       usage; exit 0 ;;
    list)                 sqmar_list_profiles; exit 0 ;;
    current)              n=$(sqmar_active_name); echo "${n:-none}"; exit 0 ;;
esac

PROFILE=$1
MAKE_DEFAULT=0
case "${2:-}" in
    '') ;;
    --default|--set-default) MAKE_DEFAULT=1 ;;
    *) sqmar_err "unknown option '$2'"; usage >&2; exit 2 ;;
esac
if [ $# -gt 2 ]; then sqmar_err "too many arguments"; usage >&2; exit 2; fi

if ! sqmar_valid_name "$PROFILE"; then
    sqmar_err "'$PROFILE' is not a profile name (letters, digits, - and _ only)"
    exit 2
fi
if ! sqmar_profile_exists "$PROFILE"; then
    sqmar_err "profile '$PROFILE' not found in $SQMAR_PROFILE_DIR"
    echo "available: $(sqmar_list_profiles | tr '\n' ' ')" >&2
    exit 1
fi

OLD=$(sqmar_active_name)

# look at the profile before switching: findings are shown, they do not stop the switch
CHECK=$(sqmar_check "$PROFILE"); CRC=$?
if [ "$CRC" -ne 0 ]; then
    echo "checks for '$PROFILE':"
    printf '%s\n' "$CHECK" | sed 's/^/  /'
fi

# runtime settings belong to the profile they were made on: drop them, and say so
RT=$(sqmar_runtime_file)
if [ -s "$RT" ]; then
    echo "dropping $(sqmar_ovr_count "$RT") runtime setting(s): $(tr '\n' ' ' < "$RT")"
    rm -f "$RT"
fi

sqmar_set_active "$PROFILE" || { sqmar_err "could not record the active profile in $SQMAR_RUN_DIR"; exit 1; }
echo "profile: ${OLD:-none} -> $PROFILE (memory only)"
sqmar_apply || exit 1

if [ "$MAKE_DEFAULT" -eq 1 ]; then
    if [ "$(sqmar_default_name)" = "$PROFILE" ]; then
        echo "boot profile is already $PROFILE (flash not written)"
    elif printf '%s\n' "$PROFILE" | sqmar_write "$SQMAR_DEFAULT_FILE"; then
        echo "boot profile: $PROFILE (written to $SQMAR_DEFAULT_FILE)"
    else
        sqmar_err "could not write $SQMAR_DEFAULT_FILE"
        exit 1
    fi
else
    echo "boot profile stays: $(sqmar_boot_name)  (add --default to change it)"
fi

if printf '%s\n' "$CHECK" | grep -q 'missing key'; then
    echo "note: a profile with missing keys can leave values of the previous profile active until a restart:"
    echo "      /etc/init.d/sqm-autorate restart"
fi
exit 0
